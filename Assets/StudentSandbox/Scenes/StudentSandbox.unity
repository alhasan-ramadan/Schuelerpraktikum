  m_Script: {fileID: 11500000, guid: fcbe98c2338e61644ba7240d94e59789, type: 3}
  m_Name: 
  m_EditorClassIdentifier: StudentSandbox.Runtime::StudentSandbox.InfoNote
  title: Der Boden der Insel
  text: "Der Boden der Insel ist ein flacher Zylinder mit 12 Ecken \u2013 so entsteht
    der Low-Poly-Look.\nEr hat einen Mesh Collider, deshalb fallen Kugeln und Objekte
    nicht hindurch.\nDarunter liegen der dunkle Grasrand, die Erde (Island_Cliff)
    und der Sandstrand (Island_Beach).\nProbier: Zieh ein anderes Material aus Materials/Palette
    auf den Boden."
