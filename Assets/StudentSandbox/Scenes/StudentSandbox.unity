  m_Script: {fileID: 11500000, guid: fcbe98c2338e61644ba7240d94e59789, type: 3}
  m_Name: 
  m_EditorClassIdentifier: StudentSandbox.Runtime::StudentSandbox.InfoNote
  title: Das Meer
  text: "Das Wasser besteht nur aus flachen Fl\xE4chen ohne Collider:\n'Lagoon' ist
    das helle Wasser nahe der Insel, 'Ocean' das dunkle Meer weiter drau\xDFen, 'Surf'
    der wei\xDFe Schaum am Strand.\nF\xE4llt eine Kugel ins Meer, kommt sie automatisch
    zu ihrem Start zur\xFCck.\nProbier: Gib der Lagune ein anderes Material \u2013
    zum Beispiel Turquoise."
